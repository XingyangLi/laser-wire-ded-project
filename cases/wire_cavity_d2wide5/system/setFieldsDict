FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0
    volScalarFieldValue T 300
    volScalarFieldValue liquidFraction 0
    volScalarFieldValue meltHistory 0
);

regions
(
    // Solid plate, T = 1500 K, below the 1658 K solidus. Melting under
    // z = 0 is generated by contact with the hot bead, not painted.
    boxToCell
    {
        box (0.0005 -1 -1) (0.004 1 0);
        fieldValues
        (
            volScalarFieldValue alpha.metal 1
            volScalarFieldValue T 1500
            volScalarFieldValue liquidFraction 0
            volScalarFieldValue meltHistory 0
        );
    }
    boxToCell
    {
        box (0.0005 -1 0) (0.00125 1 0.00156);
        fieldValues
        (
            volScalarFieldValue alpha.metal 1
            volScalarFieldValue T 2200
            volScalarFieldValue liquidFraction 1
            volScalarFieldValue meltHistory 1
        );
    }
);
